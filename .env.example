# Avighnn Global — environment configuration
# Copy to .env and fill in. Never commit .env itself.

# Port the app listens on. cPanel/Passenger sets this for you; leave
# unset in that environment.
PORT=3000

# Set to "production" on the live server. Enables HSTS and the
# upgrade-insecure-requests CSP directive.
NODE_ENV=development

# The /exec URL of the deployed Google Apps Script web app that writes
# the inquiry row. See apps-script/SETUP.md for how to deploy it.
QUOTE_ENDPOINT=
